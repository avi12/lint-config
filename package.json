{
  "name": "lint-config",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "lint": "pnpm lint:oxlint && pnpm lint:format",
    "lint:oxlint": "oxlint packages test/*.test.js test/support",
    "lint:format": "oxfmt -c packages/oxfmt-config/oxfmt.json --check packages test",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "ids:refresh": "node packages/house-rules/src/refresh-ids.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "avi12-lint": "workspace:*",
    "eslint": "^10.14.0",
    "eslint-config-avi12": "workspace:*",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-vue": "^10.12.1",
    "fallow": "2.103.0",
    "house-rules-avi12": "workspace:*",
    "oxfmt": "0.78.0",
    "oxlint": "1.90.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.56.7",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2"
  }
}
