{
  "name": "avi12-lint",
  "version": "0.9.0",
  "description": "One command that runs oxlint, ESLint, oxfmt and stylelint, in parallel, for whichever configs a repo has, and ast-grep and a text check for Rust, C++, C# and Kotlin, and ktlint and detekt for Kotlin, and clang-format and clang-tidy for C++, and cargo fmt, clippy, machete and deny for Rust",
  "license": "Apache-2.0",
  "bin": {
    "avi12-lint": "bin/avi12-lint.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./eslint-flags": "./src/eslint-flags.js",
    "./plan": "./src/plan.js",
    "./languages": "./src/languages.js",
    "./text-check": "./src/text-check.js",
    "./fallow-config": "./src/fallow-config.js",
    "./package.json": "./package.json",
    "./kotlin": "./src/kotlin.js",
    "./kotlin-tools": "./src/kotlin-tools.js",
    "./kotlin-report": "./src/kotlin-report.js",
    "./rust": "./src/rust.js",
    "./rust-config": "./src/rust-config.js",
    "./flat-toml": "./src/flat-toml.js",
    "./cpp": "./src/cpp.js",
    "./cpp-config": "./src/cpp-config.js",
    "./cpp-tidy": "./src/cpp-tidy.js",
    "./cpp-tools": "./src/cpp-tools.js",
    "./cpp-fixes": "./src/cpp-fixes.js"
  }
}
