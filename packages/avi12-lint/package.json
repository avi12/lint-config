{
  "name": "avi12-lint",
  "version": "0.4.3",
  "description": "One command that runs oxlint, ESLint, oxfmt and stylelint, in parallel, for whichever configs a repo has",
  "license": "Apache-2.0",
  "bin": {
    "avi12-lint": "bin/avi12-lint.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./eslint-flags": "./src/eslint-flags.js",
    "./plan": "./src/plan.js",
    "./package.json": "./package.json"
  }
}
