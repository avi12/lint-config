{
  "enable": [
    "bugprone-*",
    "cert-*",
    "clang-analyzer-*",
    "concurrency-*",
    "google-*",
    "hicpp-exception-baseclass",
    "misc-*",
    "modernize-*",
    "performance-*",
    "cppcoreguidelines-avoid-non-const-global-variables",
    "cppcoreguidelines-init-variables",
    "cppcoreguidelines-no-malloc",
    "cppcoreguidelines-owning-memory",
    "cppcoreguidelines-prefer-member-initializer",
    "cppcoreguidelines-pro-type-const-cast",
    "cppcoreguidelines-pro-type-cstyle-cast",
    "cppcoreguidelines-pro-type-member-init",
    "cppcoreguidelines-pro-type-reinterpret-cast",
    "cppcoreguidelines-slicing",
    "cppcoreguidelines-special-member-functions",
    "cppcoreguidelines-virtual-class-destructor",
    "readability-avoid-nested-conditional-operator",
    "readability-braces-around-statements",
    "readability-const-return-type",
    "readability-container-size-empty",
    "readability-delete-null-pointer",
    "readability-duplicate-include",
    "readability-else-after-return",
    "readability-function-cognitive-complexity",
    "readability-function-size",
    "readability-identifier-length",
    "readability-identifier-naming",
    "readability-implicit-bool-conversion",
    "readability-inconsistent-declaration-parameter-name",
    "readability-isolate-declaration",
    "readability-magic-numbers",
    "readability-make-member-function-const",
    "readability-misleading-indentation",
    "readability-misplaced-array-index",
    "readability-non-const-parameter",
    "readability-qualified-auto",
    "readability-redundant-control-flow",
    "readability-redundant-declaration",
    "readability-redundant-member-init",
    "readability-redundant-preprocessor",
    "readability-redundant-smartptr-get",
    "readability-redundant-string-cstr",
    "readability-simplify-boolean-expr",
    "readability-string-compare"
  ],
  "disable": {
    "misc-include-cleaner": "Win32 headers have hard ordering dependencies, so the include set is authored by hand",
    "misc-non-private-member-variables-in-classes": "Google style allows public data in a plain struct",
    "misc-no-recursion": "recursion over a tree is the clearest form; the cognitive complexity limit still bounds a function",
    "bugprone-reserved-identifier": "the Windows SDK and the CRT define reserved names the code must use",
    "cert-dcl37-c": "the Windows SDK and the CRT define reserved names the code must use",
    "cert-dcl51-cpp": "the Windows SDK and the CRT define reserved names the code must use",
    "cert-err33-c": "checking every printf-family result adds noise; the specific unused-return checks stay",
    "performance-enum-size": "an enum that mirrors an ABI keeps the width the ABI has",
    "modernize-use-trailing-return-type": "Google style writes the return type first",
    "modernize-use-designated-initializers": "the Win32 structs initialise by position",
    "misc-use-anonymous-namespace": "Google style allows a static function as much as an unnamed namespace, and misc-use-internal-linkage already narrows visibility",
    "modernize-avoid-c-arrays": "Win32 and COM calls take a buffer as pointer and length, and a fixed buffer on the stack is the idiom there",
    "modernize-use-auto": "Google style prefers the written type unless the type is obvious from the initializer",
    "modernize-raw-string-literal": "an escaped literal is as readable and diffs smaller",
    "modernize-macro-to-enum": "the macros are Win32 and build values the code does not own",
    "google-runtime-int": "the Win32 ABI types (DWORD, LONG, ULONG) are the contract",
    "modernize-return-braced-init-list": "a named constructor call reads clearer at a return",
    "modernize-use-ranges": "its fixer writes std::ranges::sort(range, , comparator) with an empty argument, which does not compile (LLVM 22.1.7)"
  },
  "headerFilterRegex": "(^|[/\\\\])(src|include)[/\\\\].*\\.(h|hpp)$",
  "warningsAsErrors": "*",
  "options": {
    "readability-function-cognitive-complexity.Threshold": "25",
    "readability-function-size.LineThreshold": "80",
    "readability-function-size.StatementThreshold": "80",
    "readability-function-size.ParameterThreshold": "5",
    "readability-function-size.NestingThreshold": "3",
    "readability-magic-numbers.IgnoredIntegerValues": "1;2;3;4;8;16;32;64;100;1000",
    "readability-magic-numbers.IgnorePowersOf2IntegerValues": "true",
    "readability-magic-numbers.IgnoreBitFieldsWidths": "true",
    "readability-implicit-bool-conversion.AllowPointerConditions": "true",
    "readability-implicit-bool-conversion.AllowIntegerConditions": "true",
    "readability-else-after-return.WarnOnConditionVariables": "false",
    "bugprone-easily-swappable-parameters.MinimumLength": "3",
    "bugprone-unsafe-functions.CustomFunctions": "^::sprintf$,snprintf,it cannot see the size of what it writes into; ^::strcpy$,strcpy_s,it cannot see the size of what it writes into; ^::strcat$,strcat_s,it cannot see the size of what it writes into; ^::wcscpy$,wcscpy_s,it cannot see the size of what it writes into; ^::wcscat$,wcscat_s,it cannot see the size of what it writes into; ^::gets$,fgets,it cannot see the size of what it writes into",
    "readability-identifier-length.MinimumVariableNameLength": "3",
    "readability-identifier-length.MinimumParameterNameLength": "3",
    "readability-identifier-length.IgnoredVariableNames": "^(hr|hwnd|pid|tid|rc|ok|to|i|j|x|y|id)$",
    "readability-identifier-length.IgnoredParameterNames": "^(hr|hwnd|pid|tid|rc|ok|to|i|j|x|y|id)$",
    "misc-const-correctness.AnalyzeValues": "true",
    "misc-const-correctness.AnalyzeReferences": "false",
    "misc-const-correctness.WarnPointersAsValues": "false",
    "misc-const-correctness.TransformValues": "false",
    "misc-const-correctness.TransformReferences": "false",
    "misc-const-correctness.TransformPointersAsValues": "false",
    "readability-identifier-naming.NamespaceCase": "lower_case",
    "readability-identifier-naming.ClassCase": "CamelCase",
    "readability-identifier-naming.StructCase": "CamelCase",
    "readability-identifier-naming.UnionCase": "CamelCase",
    "readability-identifier-naming.EnumCase": "CamelCase",
    "readability-identifier-naming.TypeAliasCase": "CamelCase",
    "readability-identifier-naming.TypedefCase": "CamelCase",
    "readability-identifier-naming.TemplateParameterCase": "CamelCase",
    "readability-identifier-naming.FunctionCase": "CamelCase",
    "readability-identifier-naming.MethodCase": "CamelCase",
    "readability-identifier-naming.VariableCase": "camelBack",
    "readability-identifier-naming.ParameterCase": "camelBack",
    "readability-identifier-naming.MemberCase": "camelBack",
    "readability-identifier-naming.GlobalVariableCase": "camelBack",
    "readability-identifier-naming.GlobalVariablePrefix": "g_",
    "readability-identifier-naming.ConstexprVariableCase": "CamelCase",
    "readability-identifier-naming.ConstexprVariablePrefix": "k",
    "readability-identifier-naming.GlobalConstantCase": "CamelCase",
    "readability-identifier-naming.GlobalConstantPrefix": "k",
    "readability-identifier-naming.StaticConstantCase": "CamelCase",
    "readability-identifier-naming.StaticConstantPrefix": "k",
    "readability-identifier-naming.ClassConstantCase": "CamelCase",
    "readability-identifier-naming.ClassConstantPrefix": "k",
    "readability-identifier-naming.EnumConstantCase": "CamelCase",
    "readability-identifier-naming.EnumConstantPrefix": "k",
    "readability-identifier-naming.MacroDefinitionCase": "UPPER_CASE",
    "readability-identifier-naming.StaticVariableCase": "camelBack",
    "readability-identifier-naming.StaticVariablePrefix": "s_",
    "readability-identifier-naming.MacroDefinitionIgnoredRegexp": "^[A-Z0-9_]+_H_$",
    "readability-identifier-naming.PrivateMemberCase": "camelBack",
    "readability-identifier-naming.PrivateMemberSuffix": "_",
    "readability-identifier-naming.ProtectedMemberCase": "camelBack",
    "readability-identifier-naming.ProtectedMemberSuffix": "_"
  }
}
