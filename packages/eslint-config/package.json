{
  "name": "eslint-config-avi12",
  "version": "0.3.0",
  "description": "ESLint flat config for Svelte files only: the template rules oxlint and oxfmt cannot see",
  "license": "Apache-2.0",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./svelte": "./src/svelte.js",
    "./defaults": "./src/defaults.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "eslint": "^9.20.0 || ^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "svelte-eslint-parser": "^1.0.0",
    "typescript": ">=5.5"
  }
}
