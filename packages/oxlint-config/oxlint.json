{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./plugins/unused-imports.js",
    "./plugins/perfectionist.js",
    "./plugins/stylistic.js",
    "./plugins/jsdoc-js.js",
    "./plugins/house/index.js"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import", "jsdoc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "builtin": true
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "curly": ["error", "all"],
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "prefer-const": [
      "error",
      {
        "destructuring": "all"
      }
    ],
    "no-var": "error",
    "no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "no-nested-ternary": "error",
    "no-else-return": [
      "error",
      {
        "allowElseIf": false
      }
    ],
    "no-lonely-if": "error",
    "no-throw-literal": "error",
    "no-restricted-exports": [
      "error",
      {
        "restrictDefaultExports": {
          "direct": true,
          "named": true,
          "defaultFrom": true,
          "namedFrom": true,
          "namespaceFrom": true
        }
      }
    ],
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    "object-shorthand": [
      "error",
      "always",
      {
        "avoidExplicitReturnArrows": true
      }
    ],
    "id-length": [
      "error",
      {
        "min": 3,
        "exceptions": ["_", "i", "j", "x", "y", "id", "to", "on", "ok", "T"],
        "properties": "never"
      }
    ],
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": false
      }
    ],
    "arrow-body-style": ["error", "as-needed"],
    "no-warning-comments": [
      "error",
      {
        "terms": ["eslint-disable", "oxlint-disable", "@ts-ignore", "@ts-nocheck"],
        "location": "anywhere"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*", "./../*"],
            "message": "Import from the project root with \"@/path\", never \"../\""
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "ts-expect-error": "allow-with-description",
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/prefer-for-of": "error",
    "typescript/array-type": [
      "error",
      {
        "default": "array"
      }
    ],
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/parameter-properties": [
      "error",
      {
        "prefer": "class-property",
        "allow": ["readonly", "private readonly", "protected readonly"]
      }
    ],
    "typescript/explicit-member-accessibility": [
      "error",
      {
        "accessibility": "no-public"
      }
    ],
    "typescript/no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "import/first": "error",
    "import/no-cycle": [
      "error",
      {
        "ignoreTypes": true
      }
    ],
    "no-magic-numbers": "off",
    "no-restricted-globals": [
      "error",
      {
        "name": "Reflect",
        "message": "Do not use Reflect. Use direct property access instead."
      }
    ],
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-reduce": "error",
    "unused-imports/no-unused-imports": "error",
    "perfectionist/sort-named-imports": [
      "error",
      {
        "type": "alphabetical",
        "order": "asc",
        "ignoreCase": true
      }
    ],
    "perfectionist/sort-named-exports": [
      "error",
      {
        "type": "alphabetical",
        "order": "asc",
        "ignoreCase": true
      }
    ],
    "perfectionist/sort-objects": [
      "error",
      {
        "type": "unsorted",
        "newlinesBetween": 0
      }
    ],
    "@stylistic/spaced-comment": ["error", "always"],
    "@stylistic/object-curly-newline": [
      "error",
      {
        "ObjectExpression": {
          "consistent": true,
          "multiline": true
        },
        "ObjectPattern": {
          "consistent": true,
          "multiline": true
        },
        "ExportDeclaration": {
          "consistent": true,
          "multiline": true
        }
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "import",
        "next": ["const", "let", "function", "export", "type"]
      },
      {
        "blankLine": "any",
        "prev": "import",
        "next": "import"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "if"
      },
      {
        "blankLine": "never",
        "prev": ["const", "let"],
        "next": "if"
      },
      {
        "blankLine": "always",
        "prev": "if",
        "next": "*"
      }
    ],
    "@stylistic/function-call-argument-newline": ["error", "consistent"],
    "@stylistic/function-paren-newline": ["error", "consistent"],
    "house/expand-nested-object-expression": "error",
    "house/expand-nested-type-literal": "error",
    "house/multiline-arg-paren-newline": "error",
    "house/no-em-dash": "error",
    "house/no-magic-numbers": "error",
    "house/google-syntax": "error",
    "house/house-syntax": "error",
    "house/positional-parameters": "error"
  },
  "overrides": [
    {
      "files": ["*.config.{js,mjs,ts}", "**/vite.config.ts"],
      "rules": {
        "no-restricted-exports": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "test/**/*.ts"],
      "rules": {
        "house/no-magic-numbers": "off",
        "max-nested-callbacks": "off"
      }
    },
    {
      "files": ["**/*.svelte"],
      "rules": {
        "house/no-em-dash": "off",
        "unused-imports/no-unused-imports": "off",
        "typescript/no-unused-vars": "off",
        "no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.svelte-kit/**",
    "**/.worktrees/**",
    "**/.claude/worktrees/**",
    "**/.verify/**"
  ]
}
